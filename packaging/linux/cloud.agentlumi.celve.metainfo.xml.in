<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>cloud.agentlumi.celve</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Celve</name>
  <summary>Calculate, analyse and chart data in workbooks</summary>
  <developer id="cloud.agentlumi">
    <name>Celve contributors</name>
  </developer>
  <description>
    <p>
      Celve is an open-source, native spreadsheet. It opens and saves .xlsx workbooks and
      CSV/TSV files, evaluates hundreds of worksheet functions, and formats, sorts, filters and
      charts your data.
    </p>
    <p>
      Every action is a command that the included celve-cli tool and AI agents (over MCP)
      can run too, so workbooks can be built and checked without opening a window. Sage, the built-in assistant, answers questions, reads pictures and
      builds workbooks for you.
    </p>
    <p>
      Celve is based on GridCraft by the ArtCraft team.
    </p>
  </description>
  <launchable type="desktop-id">cloud.agentlumi.celve.desktop</launchable>
  <icon type="stock">cloud.agentlumi.celve</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/BitCodeHub/celve</url>
  <url type="bugtracker">https://github.com/BitCodeHub/celve/issues</url>
  <url type="help">https://github.com/BitCodeHub/celve</url>
  <url type="contact">https://github.com/BitCodeHub/celve/issues</url>
  <categories>
    <category>Office</category>
    <category>Spreadsheet</category>
  </categories>
  <keywords>
    <keyword>spreadsheet</keyword>
    <keyword>workbook</keyword>
    <keyword>formula</keyword>
    <keyword>xlsx</keyword>
    <keyword>csv</keyword>
  </keywords>
  <!-- Proposed app colour (Celve green #1f9d55 / ink #147a40); see assets/app-icon/README.md. -->
  <branding>
    <color type="primary" scheme_preference="light">#a7e3bf</color>
    <color type="primary" scheme_preference="dark">#147a40</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>celve</binary>
    <binary>celve-cli</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</mediatype>
    <mediatype>application/vnd.ms-excel.sheet.macroEnabled.12</mediatype>
    <mediatype>text/csv</mediatype>
    <mediatype>text/tab-separated-values</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>

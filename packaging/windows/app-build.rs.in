// TEMPLATE for apps/celve/build.rs (copied from DesignCraft by the release-tooling setup;
// apps/celve didn't exist yet). Move it there and add to apps/celve/Cargo.toml:
//
//   [build-dependencies]
//   # Icon + VERSIONINFO for celve.exe; build.rs only uses it when the target is Windows.
//   winresource = "0.1"
//
// and to apps/celve/src/main.rs (package.ps1 checks the exe is a GUI-subsystem binary):
//
//   #![cfg_attr(all(target_os = "windows", not(debug_assertions)), windows_subsystem = "windows")]
//
// package.ps1 sets CELVE_REQUIRE_WINRES=1 so release builds fail without the resources.

//! Windows only: embed the app icon and version info (VERSIONINFO) into `celve.exe`, so it
//! shows in Explorer, the taskbar, the Start menu and Alt-Tab.
//!
//! On every other target this does nothing. A missing resource compiler is a warning, so a
//! cross-compile from macOS or Linux still links, unless `CELVE_REQUIRE_WINRES=1` turns it
//! into an error (for release builds).

fn main() {
    println!("cargo:rerun-if-changed=build.rs");
    println!("cargo:rerun-if-changed=../../assets/app-icon/celve.ico");
    println!("cargo:rerun-if-env-changed=CELVE_REQUIRE_WINRES");
    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("windows") {
        return;
    }
    let mut res = winresource::WindowsResource::new();
    res.set_icon("../../assets/app-icon/celve.ico")
        .set("ProductName", "Celve")
        .set("FileDescription", "Celve spreadsheet")
        .set("CompanyName", "Celve contributors")
        .set("LegalCopyright", "Copyright (c) the Celve authors. MIT OR Apache-2.0.")
        .set("OriginalFilename", "celve.exe")
        .set("InternalName", "celve");
    if let Err(e) = res.compile() {
        if std::env::var_os("CELVE_REQUIRE_WINRES").is_some() {
            eprintln!("embedding Windows resources failed: {e}");
            std::process::exit(1);
        }
        println!("cargo:warning=celve.exe built without icon/version resources: {e}");
    }
}
